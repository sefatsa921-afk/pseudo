# Development-only names. Never commit real credentials.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me

# Legacy client key: use only if your dashboard has not created a publishable key yet.
# SUPABASE_ANON_KEY=legacy-anon-key

# Server-only. Never put either of these in the APK or frontend.
# SUPABASE_SECRET_KEY=sb_secret_server-only
# SUPABASE_SERVICE_ROLE_KEY=legacy-service-role-server-only
